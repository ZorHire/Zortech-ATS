{
  "compilerOptions": {
    "module": "node16",
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "target": "es2017"
  },
  "compileOnSave": true,
  "include": ["src"]
}
