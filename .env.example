# Backend Configuration
SERVER_PORT=5000
SERVER_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SERVER_JWT_SECRET=your_jwt_secret_min_32_chars
SERVER_NODE_ENV=production

# Frontend Configuration (Vite)
VITE_API_URL=https://your-api-url/v1


# AES-256 key for encrypting per-user SMTP app-passwords at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_ENCRYPTION_KEY=your_64_char_hex_key

# Gemini API key for resume/JD parsing
GEMINI_API_KEY=your_gemini_api_key

# Frontend URL — used in password-reset email links
SERVER_FRONTEND_URL=https://your-frontend-domain.com

# Razorpay payment gateway (required — subscriptions will not activate without this)
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Database-per-tenant multi-tenancy (Phase 3+) ─────────────────────────────
# Neon base connection URL (without the database name).
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech
# If not set, derived automatically from SERVER_DATABASE_URL at startup.
# Set explicitly if your tenant DBs are in a different Neon project than the platform DB.
# NEON_BASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech

# Redis — generated by vps-setup.sh on first run (do not set manually)
# REDIS_PASS is read by docker-compose.yml to set the Redis requirepass.
# REDIS_URL is read by the backend to connect with auth.
# REDIS_PASS=<generated-by-vps-setup.sh>
# REDIS_URL=redis://:<password>@redis:6379

