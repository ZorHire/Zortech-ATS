# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# For local development, see the "Dev (Docker)" section below.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=5000
SERVER_NODE_ENV=development

# Change this to any long random string (min 32 chars) — never share or commit it
SERVER_JWT_SECRET=your_jwt_secret_min_32_chars

# Frontend URL — used in password-reset email links
SERVER_FRONTEND_URL=http://localhost:5173

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
#
# Option A — Local dev via Docker (recommended for new devs, no sign-up needed):
#   1. Install Docker Desktop: https://www.docker.com/products/docker-desktop
#   2. Run: docker compose -f docker-compose.dev.yml up -d
#   3. Use the value below as-is.
SERVER_DATABASE_URL=postgresql://zortech:zortech@localhost:5432/zortech_hosting
#
# Option B — Free cloud Postgres (Neon, Supabase, Railway — all have free tiers):
#   Sign up, create a project, copy the connection string.
# SERVER_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Database-per-tenant multi-tenancy ────────────────────────────────────────
# Neon base connection URL (without the database name).
# If not set, derived automatically from SERVER_DATABASE_URL at startup.
# Only needed if your tenant DBs are in a different Neon project.
# NEON_BASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech

# ── Redis ─────────────────────────────────────────────────────────────────────
#
# Option A — Local dev via Docker (same docker-compose.dev.yml as above):
REDIS_URL=redis://localhost:6379
#
# Option B — Free cloud Redis (Upstash free tier: https://upstash.com):
# REDIS_URL=rediss://:password@host:port
#
# Production (VPS — password set by vps-setup.sh):
# REDIS_PASS=<generated-by-vps-setup.sh>
# REDIS_URL=redis://:<password>@redis:6379

# ── Email Encryption ──────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting per-user SMTP passwords stored in the DB.
# Must be exactly 64 hex characters (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank in development — SMTP features won't work but everything else will.
EMAIL_ENCRYPTION_KEY=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/v1

# ── Optional — leave blank to disable those features ─────────────────────────

# Google Gemini — resume/JD parsing AI
GEMINI_API_KEY=

# Razorpay — subscription billing
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

