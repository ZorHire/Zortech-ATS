# Backend Configuration
SERVER_PORT=5000
SERVER_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SERVER_JWT_SECRET=your_jwt_secret_min_32_chars
SERVER_NODE_ENV=development

# Frontend Configuration (Vite)
VITE_API_URL=https://your-api-url/v1

# Email Configuration (Zoho SMTP fallback)
SERVER_SMTP_HOST=smtppro.zoho.in
SERVER_SMTP_PORT=465
SERVER_SMTP_SECURE=true
# SERVER_SMTP_USER=you@yourdomain.com
# SERVER_SMTP_PASS=your_app_password

# AES-256 key for encrypting per-user SMTP app-passwords at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_ENCRYPTION_KEY=your_64_char_hex_key

# Gemini API key for resume/JD parsing
GEMINI_API_KEY=your_gemini_api_key
